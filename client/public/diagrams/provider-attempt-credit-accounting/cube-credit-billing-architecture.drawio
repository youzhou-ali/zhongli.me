ometry></mxCell><mxCell id="p4-note" value="dispatch 后 Accounting 失败：只重试同一个 Settlement，不允许生成新的 Provider 请求" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FFF8D9;strokeColor=#B98A00;" vertex="1" parent="1"><mxGeometry x="500" y="468" width="272" height="70" as="geometry" /></mxCell><mxCell id="p4-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#B98A00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4-7" target="p4-note"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="402" y="440" /><mxPoint x="486" y="440" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="retry-settlement-barrier" name="05 Retry Fallback Settlement Barrier"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p5-title" value="Retry / Fallback 必须穿过终态 Barrier" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="28" y="16" width="744" height="34" as="geometry" /></mxCell><mxCell id="p5-title-sub" value="已 dispatch 必须先 Settlement；not_dispatched 无 Ledger；LiteLLM 隐藏 retry/fallback 全部关闭" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="55" y="47" width="690" height="24" as="geometry" /></mxCell><mxCell id="p5-call" value="Model Call · call_id 固定" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#F8FAFD;strokeColor=#3973C6;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingTop=7;spacingLeft=8;dashed=1;dashPattern=6 4;opacity=55;" vertex="1" parent="1"><mxGeometry x="20" y="82" width="760" height="430" as="geometry" /></mxCell><mxCell id="p5-a1" value="&lt;b&gt;Attempt 1&lt;/b&gt;&lt;br&gt;primary deployment&lt;br&gt;dispatch" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E8F1FF;strokeColor=#3973C6;" vertex="1" parent="1"><mxGeometry x="46" y="146" width="136" height="92" as="geometry" /></mxCell><mxCell id="p5-r1" value="Provider outcome&lt;br&gt;可能失败但有 Usage" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#F3F5F8;strokeColor=#7A8494;" vertex="1" parent="1"><mxGeometry x="218" y="146" width="136" height="92" as="geometry" /></mxCell><mxCell id="p5-s1" value="&lt;b&gt;Settlement 1&lt;/b&gt;&lt;br&gt;Ledger + Charge&lt;br&gt;必须 COMMIT" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E8F6E8;strokeColor=#3D8B40;" vertex="1" parent="1"><mxGeometry x="390" y="136" width="150" height="112" as="geometry" /></mxCell><mxCell id="p5-decision" value="继续 retry / fallback ?" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FFF8D9;strokeColor=#B98A00;shape=rhombus;perimeter=rhombusPerimeter;arcSize=0;" vertex="1" parent="1"><mxGeometry x="582" y="146" width="130" height="92" as="geometry" /></mxCell><mxCell id="p5-sfail" value="Accounting 暂时失败&lt;br&gt;&lt;b&gt;仅重试 S