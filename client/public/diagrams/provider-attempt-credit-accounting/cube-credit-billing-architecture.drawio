metry relative="1" as="geometry" /></mxCell><mxCell id="p3-note" value="正常 timeout / cancel 由仍持有执行权的 owner 结算；stale scanner 被明确删除。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="105" y="525" width="590" height="34" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="paid-attempt-flow" name="04 Paid Attempt Flow"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4-title" value="一次付费 Provider Attempt 的完整流程" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="28" y="16" width="744" height="34" as="geometry" /></mxCell><mxCell id="p4-title-sub" value="任何 Provider 外部 I/O 都位于 dispatching 提交之后；非流式结果位于 Settlement 提交之后" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="55" y="47" width="690" height="24" as="geometry" /></mxCell><mxCell id="p4-1" value="&lt;b&gt;1 · 选择实际 deployment&lt;/b&gt;&lt;br&gt;确定 llm_code / provider / model" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E3F6F1;strokeColor=#16806A;" vertex="1" parent="1"><mxGeometry x="26" y="104" width="170" height="92" as="geometry" /></mxCell><mxCell id="p4-2" value="&lt;b&gt;2 · Admission 事务&lt;/b&gt;&lt;br&gt;读取 Workload、Pricing、Balance&lt;br&gt;paid 要求 balance &gt; 0" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FFF8D9;strokeColor=#B98A00;" vertex="1" parent="1"><mxGeometry x="218" y="104" width="170" height="92" as="geometry" /></mxCell><mxCell id="p4-3" value="&lt;b&gt;3 · 插入 prepared&lt;/b&gt;&lt;br&gt;冻结 subject / revision / attribution" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E8F1FF;strokeColor=#3973C6;" vertex="1" parent="1"><mxGeometry x="410" y="104" width="170" height="92" as="geometry" /></mxCell><mxCell id="p4-4" value="&lt;b&gt;4 · CAS dispatching&lt;/b&gt;&lt;br&gt;事务提交且只更新一行" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FFF1DE;strokeColor=#C77818;" vertex="1" parent="1"><mxGeometry x="602" y="104" width="170" height="92" as="geometry" /></mxCell><mxCell id="p4-5" value="&lt;b&gt;5 · Provider I/O&lt;/b&gt;&lt;br&gt;每次真实请求恰好一个 Attempt" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E8F1FF;strokeColor=#3973C6;" vertex="1" parent="1"><mxGeometry x="602" y="330" width="170" height="92" as="geometry" /></mxCell><mxCell id="p4-6" value="&lt;b&gt;6 · 归一化 Usage&lt;/b&gt;&lt;br&gt;valid / missing / invalid&lt;br&gt;Streaming 取最后有效累计值" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E3F6F1;strokeColor=#16806A;" vertex="1" parent="1"><mxGeometry x="410" y="330" width="170" height="92" as="geometry" /></mxCell><mxCell id="p4-7" value="&lt;b&gt;7 · Atomic Settlement&lt;/b&gt;&lt;br&gt;terminal + Ledger + Debit + Balance" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacin