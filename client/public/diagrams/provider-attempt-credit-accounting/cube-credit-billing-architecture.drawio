h="690" height="24" as="geometry" /></mxCell><mxCell id="p6-timeline" value="调用时间线  →" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="28" y="82" width="744" height="28" as="geometry" /></mxCell><mxCell id="p6-w1" value="&lt;b&gt;W1&lt;/b&gt;&lt;br&gt;prepared 提交前&lt;br&gt;&lt;br&gt;无 Attempt&lt;br&gt;无 dispatch&lt;br&gt;&lt;b&gt;零收费&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#F3F5F8;strokeColor=#7A8494;" vertex="1" parent="1"><mxGeometry x="22" y="128" width="140" height="230" as="geometry" /></mxCell><mxCell id="p6-w2" value="&lt;b&gt;W2&lt;/b&gt;&lt;br&gt;prepared 已提交&lt;br&gt;dispatching CAS 前&lt;br&gt;&lt;br&gt;清理 CAS 抢占成功&lt;br&gt;才记 not_dispatched&lt;br&gt;CAS=0 必须重读&lt;br&gt;&lt;b&gt;无 Ledger&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E8F1FF;strokeColor=#3973C6;" vertex="1" parent="1"><mxGeometry x="176" y="128" width="140" height="230" as="geometry" /></mxCell><mxCell id="p6-w3" value="&lt;b&gt;W3&lt;/b&gt;&lt;br&gt;dispatching 已提交&lt;br&gt;网络发送前后&lt;br&gt;&lt;br&gt;无法确认是否到达&lt;br&gt;保持 dispatching&lt;br&gt;&lt;b&gt;派生 incomplete&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FDEBEC;strokeColor=#C83E4D;" vertex="1" parent="1"><mxGeometry x="330" y="128" width="140" height="230" as="geometry" /></mxCell><mxCell id="p6-w4" value="&lt;b&gt;W4&lt;/b&gt;&lt;br&gt;Provider 已返回&lt;br&gt;Settlement 提交前&lt;br&gt;&lt;br&gt;Usage 可能随进程丢失&lt;br&gt;仍为 incomplete&lt;br&gt;&lt;b&gt;不 Reconcile&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FDEBEC;strokeColor=#C83E4D;" vertex="1" parent="1"><mxGeometry x="484" y="128" width="140" height="230" as="geometry" /></mxCell><mxCell id="p6-w5" value="&lt;b&gt;W5&lt;/b&gt;&lt;br&gt;Settlement 已提交&lt;br&gt;&lt;br&gt;terminal + Ledger&lt;br&gt;+ Debit + Balance&lt;br&gt;&lt;b&gt;原子且幂等&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E8F6E8;strokeColor=#3D8B40;" vertex="1" parent="1"><mxGeometry x="638" y="128" width="140" height="230" as="geometry" /></mxCell><mxCell id="p6-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#8A94A6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;endArrow=open;" edge="1" parent="1" source="p6-w1" target="p6-w2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#8A94A6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;endArrow=open;" edge="1" parent="1" source="p6-w2" target="p6-w3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#8A94A6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;endArrow=open;" edge="1" parent="1" source="p6-w3" target="p6-w4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#8A94A6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;endArrow=open;" edge="1" parent="1" source="p6-w4" target="p6-w5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6-rule1" value="&lt;b&gt;不自动重发&lt;/b&gt;&lt;br&gt;可能已执行的请求不能靠猜测重放" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FFF8D9;strokeColor=#B98A00;" vertex="1" parent="1"><mxGeometry x="90" y="410" width="190" height="76" as="geometry" /></mxCell><mxCell id="p6-rule2" value="&lt;b&gt;不自动终结 stale dispatching&lt;/b&gt;&lt;br&gt;避免与迟到的有效 Usage 竞争" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FFF8D9;strokeColor=#B98A00;" vertex="1" parent="1"><mxGeometry x="305" y="410" width="190" height="76" as="geometry" /></mxCell><mxCell id="p6-rule3" value="&lt;b&gt;不补扣&lt;/b&gt;&lt;br&gt;Missing / Invalid / 崩溃丢失 Usage&lt;br&gt;都由平台承担损失" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FFF8D9;strokeColor=#B98A00;" vertex="1" parent="1"><mxGeometry x="520" y="410" width="190" height="76" as="geometry" /></mxCell><mxCell id="p6-note" value="Run.error_code 在 Runtime DB 整体不可用时只能 best-effort 返回或记录，不能承诺一定持久化。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="600" height="34" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="topup-fulfillment" name="07 Top-up Fulfillment"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p7-title" value="充值支付与 Credits 交付" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="28" y="16" width="744" height="34" as="geometry" /></mxCell><mxCell id="p7-title-sub" value="#18 只定义渠道无关契约；真实 checkout / Webhook / 验签由 #22 实现" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="55" y="47" width="690" height="24" as="geometry" /></mxCell><mxCell id="p7-account-zone" value="Playground Account Database" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FBF7FF;strokeColor=#7C4DCC;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingTop=7;spacingLeft=8;dashed=1;dashPattern=6 4;opacity=55;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="382" height="342" as="geometry" /></mxCell><mxCell id="p7-runtime-zone" value="Runtime Database" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FFF9EF;strokeColor=#C77818;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingTop=7;spacingLeft=8;dashed=1;dashPattern=6 4;opacity=55;" vertex="1" parent="1"><mxGeometry x="556" y="100" width="222" height="342" as="geometry" /></mxCell><mxCell id="p7-account" value="&lt;b&gt;Account&lt;/b&gt;&lt;br&gt;选择固定 Top-up Package" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E8F1FF;strokeColor=#3973C6;" vertex="1" parent="1"><mxGeometry x="20" y="214" width="110" height="82" as="geometry" /></mxCell><mxCell id="p7-order" value="&lt;b&gt;Top-up Order&lt;/b&gt;&lt;br&gt;套餐、金额、币种、Credits 快照&lt;br&gt;v1 与 Payment 1:1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#F2EAFE;strokeColor=#7C4DCC;" vertex="1" parent="1"><mxGeometry x="172" y="160" width="156" height="104" as="geometry" /></mxCell><mxCell id="p7-payment" value="&lt;b&gt;Payment Transaction&lt;/b&gt;&lt;br&gt;UQ channel + transaction_id&lt;br&gt;status = succeeded&lt;br&gt;credited_at = NULL&lt;br&gt;&lt;b&gt;即 Credit Pending&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#F2EAFE;strokeColor=#7C4DCC;" vertex="1" parent="1"><mxGeometry x="354" y="154" width="156" height="116" as="geometry" /></mxCell><mxCell id="p7-worker" value="&lt;b&gt;Fulfillment Worker&lt;/b&gt;&lt;br&gt;扫描 succeeded AND&lt;br&gt;credited_at IS NULL" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FFF8D9;strokeColor=#B98A00;" vertex="1" parent="1"><mxGeometry x="354" y="318" width="156" height="88" as="geometry" /></mxCell><mxCell id="p7-wallet" value="&lt;b&gt;top_up_credit Wallet Entry&lt;/b&gt;&lt;br&gt;source_id = payment_transaction_id&lt;br&gt;UNIQUE(entry_kind, source_id)&lt;br&gt;+ 原子更新 Wallet Balance" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E8F6E8;strokeColor=#3D8B40;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="176" height="126" as="geometry" /></mxCell><mxCell id="p7-credited" value="&lt;b&gt;Payment Transaction CAS&lt;/b&gt;&lt;br&gt;credited_at = now" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#E8F6E8;strokeColor=#3D8B40;" vertex="1" parent="1"><mxGeometry x="172" y="318" width="156" height="88" as="geometry" /></mxCell><mxCell id="p7-provider" value="真实 Payment Provider&lt;br&gt;&lt;b&gt;Issue #22&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#F3F5F8;strokeColor=#7A8494;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="110" height="70" as="geometry" /></mxCell><mxCell id="p7-e1" value="create" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#7C4DCC;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-account" target="p7-order"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e2" value="pay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#7C4DCC;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-order" target="p7-payment"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e3" value="verified success · 可重复通知" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#7A8494;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="p7-provider" target="p7-payment"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="142" y="136" /><mxPoint x="432" y="136" /></Array></mxGeometry></mxCell><mxCell id="p7-e4" value="pending" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#B98A00;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-payment" target="p7-worker"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e5" value="幂等 deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#3D8B40;strokeWidth=2.2;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-worker" target="p7-wallet"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7-e6" value="ack → mark credited" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#3D8B40;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="p7-wallet" target="p7-credited"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="668" y="430" /><mxPoint x="250" y="430" /></Array></mxGeometry></mxCell><mxCell id="p7-e7" value="回写前崩溃 → 重投" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#C83E4D;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#172033;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="p7-wallet" target="p7-worker"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="548" y="458" /><mxPoint x="432" y="458" /></Array></mxGeometry></mxCell><mxCell id="p7-fake" value="deterministic fake payment&lt;br&gt;&lt;b&gt;仅测试 / 显式开发环境&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FDEBEC;strokeColor=#C83E4D;" vertex="1" parent="1"><mxGeometry x="160" y="490" width="222" height="60" as="geometry" /></mxCell><mxCell id="p7-prod" value="#22 完成前生产充值入口：&lt;br&gt;&lt;b&gt;暂未开放 · 不得提前启用付费配置&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FFF8D9;strokeColor=#B98A00;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="222" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="viewer-aware-error" name="08 Viewer-aware Error Projection"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p8-title" value="共享 Session 中的 Billing 错误投影" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="28" y="16" width="744" height="34" as="geometry" /></mxCell><mxCell id="p8-title-sub" value="同一个 Run 事实必须根据 viewer 生成不同展示；实时、重连与历史查询复用同一规则" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#5B6475;" vertex="1" parent="1"><mxGeometry x="55" y="47" width="690" height="24" as="geometry" /></mxCell><mxCell id="p8-run" value="&lt;b&gt;Run / Command result&lt;/b&gt;&lt;br&gt;error_code = insufficient_credits&lt;br&gt;workload → billing_subject_id" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#172033;spacing=6;arcSize=10;fillColor=#FDEBEC;strokeColor=#C83E4D;" vertex="1" parent="1"><mxGeometry x="42" y="214" width="196" height="116" as="geometry" /></mxCell><mxCell id="p8-realtime" value="Realtime&lt;br&gt;run_upsert" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fo