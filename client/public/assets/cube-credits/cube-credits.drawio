<mxfile host="app.diagrams.net" modified="2026-08-20T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="erd" name="Credits 领域模型"><mxGraphModel dx="1000" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="650" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Cube Credits 领域模型" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172033;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="520" height="35" as="geometry" /></mxCell><mxCell id="3" value="六个新增实体 + 现有 PlaygroundAccount；实线是数据库 FK/投影更新，虚线是逻辑引用，紫色表示跨库。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="53" width="790" height="22" as="geometry" /></mxCell><mxCell id="4" value="Runtime Database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5FBF8;strokeColor=#B7DDCB;fontColor=#14532D;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="25" y="90" width="510" height="525" as="geometry" /></mxCell><mxCell id="5" value="Playground Account Database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFAF2;strokeColor=#E7C38E;fontColor=#7C3E00;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="550" y="90" width="270" height="525" as="geometry" /></mxCell><mxCell id="6" value="WorkloadBillingAssignment&lt;br&gt;&lt;font style='font-size:10px'&gt;PK workload_id&lt;br&gt;billing_subject_ref&lt;br&gt;created_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F8F1;strokeColor=#3A8D68;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="200" height="115" as="geometry" /></mxCell><mxCell id="7" value="ModelCallCharge&lt;br&gt;&lt;font style='font-size:9px'&gt;PK model_call_charge_id&lt;br&gt;UQ source_msg_id · FK workload_id&lt;br&gt;session_id? · run_id?&lt;br&gt;agency_code · actual_llm_code · model_id?&lt;br&gt;4× *_tokens · 4× *_rate_microcredits_per_million&lt;br&gt;customer_charge_microcredits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F8F1;strokeColor=#3A8D68;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="285" y="125" width="225" height="175" as="geometry" /></mxCell><mxCell id="8" value="CreditBalance&lt;br&gt;&lt;font style='font-size:10px'&gt;PK billing_subject_ref&lt;br&gt;balance_microcredits&lt;br&gt;&lt;i&gt;可由 Transactions 重建&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F8F1;strokeColor=#3A8D68;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="200" height="100" as="geometry" /></mxCell><mxCell id="9" value="CreditTransaction&lt;br&gt;&lt;font style='font-size:9px'&gt;PK credit_transaction_id&lt;br&gt;UQ (kind, source_ref)&lt;br&gt;billing_subject_ref · delta_microcredits&lt;br&gt;posted_at&lt;br&gt;&lt;i&gt;余额变化唯一事实源&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F8F1;strokeColor=#3A8D68;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="285" y="390" width="225" height="135" as="geometry" /></mxCell><mxCell id="10" value="PlaygroundAccount（现有）&lt;br&gt;&lt;font style='font-size:10px'&gt;PK user_code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#C47A1B;fontColor=#7C3E00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575" y="135" width="220" height="70" as="geometry" /></mxCell><mxCell id="11" value="CreditPurchaseOrder&lt;br&gt;&lt;font style='font-size:9px'&gt;PK credit_purchase_order_id&lt;br&gt;FK account_user_code&lt;br&gt;UQ (account_user_code, idempotency_key)&lt;br&gt;option_code · payment_amount_minor_units&lt;br&gt;currency · credit_amount_microcredits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#C47A1B;fontColor=#7C3E00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575" y="250" width="220" height="140" as="geometry" /></mxCell><mxCell id="12" value="CreditPayment&lt;br&gt;&lt;font style='font-size:9px'&gt;PK credit_payment_id&lt;br&gt;UQ/FK credit_purchase_order_id&lt;br&gt;credit_fulfillment_status&lt;br&gt;created_at · credited_at?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#C47A1B;fontColor=#7C3E00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575" y="445" width="220" height="110" as="geometry" /></mxCell><mxCell id="13" value="1 → 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="14" value="1 → 0..1 · source_ref = model_call_charge_id · logical / no FK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;dashed=1;dashPattern=6 4;strokeWidth=1.5;strokeColor=#64748B;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="7" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="15" value="同事务原子增量" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.65;entryX=1;entryY=0.55;" edge="1" parent="1" source="9" target="8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="16" value="1 → 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="17" value="1 → 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="18" value="billing_subject_ref = Account.user_code · cross-DB / no FK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;dashed=1;dashPattern=6 4;strokeWidth=1.5;strokeColor=#8B5CF6;fontSize=9;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.25;entryX=1;entryY=0.2;" edge="1" parent="1" source="10" target="6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="115" /><mxPoint x="265" y="115" /></Array></mxGeometry></mxCell><mxCell id="19" value="1 → 0..1 · source_ref = credit_payment_id · cross-DB / no FK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;dashed=1;dashPattern=6 4;strokeWidth=1.5;strokeColor=#8B5CF6;fontSize=9;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;entryX=1;entryY=0.75;" edge="1" parent="1" source="12" target="9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="585" /><mxPoint x="525" y="585" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="charge" name="扣费详细流程"><mxGraphModel dx="1000" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="650" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Model Call 扣费详细流程" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172033;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="560" height="35" as="geometry" /></mxCell><mxCell id="3" value="准入 fail-closed；Provider 成功后的结算 fail-open。Charge 与 Metric 共用 PostModelCall 输入，按 priority 顺序执行、事务独立。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="53" width="790" height="22" as="geometry" /></mxCell><mxCell id="4" value="1. Agent Loop&lt;br&gt;准备 Model Call" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F1FF;strokeColor=#4F7CAC;fontColor=#17365D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="145" height="70" as="geometry" /></mxCell><mxCell id="5" value="2. PreModelCall&lt;br&gt;CreditAdmissionHook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F8F1;strokeColor=#3A8D68;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="215" y="100" width="180" height="90" as="geometry" /></mxCell><mxCell id="6" value="3. Provider / Router&lt;br&gt;实际请求" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="155" height="70" as="geometry" /></mxCell><mxCell id="7" value="4. ModelCallEndEvent&lt;br&gt;PostModelCall" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F1FF;strokeColor=#4F7CAC;fontColor=#17365D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="170" height="90" as="geometry" /></mxCell><mxCell id="8" value="Admission 检查与改动点&lt;br&gt;&lt;font style='font-size:10px'&gt;• direct 或 labels 命中的 Router fallback 链&lt;br&gt;• 所有候选保存 free/paid marker&lt;br&gt;• 有付费候选：Assignment 存在、Balance &amp;gt; 0、四项 Rate 完整&lt;br&gt;• 写入 (run_id, turn_id, source) snapshot&lt;br&gt;• 不冻结 Credits；operational 异常转 blocking_error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F8F1;strokeColor=#3A8D68;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="225" width="275" height="160" as="geometry" /></mxCell><mxCell id="9" value="最终成功事实&lt;br&gt;&lt;font style='font-size:10px'&gt;stop / length / toolUse&lt;br&gt;最终归一化 Usage&lt;br&gt;可信 actual_llm_code&lt;br&gt;source_msg_id 存在&lt;br&gt;model_id 可空&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="485" y="225" width="180" height="130" as="geometry" /></mxCell><mxCell id="10" value="LLMMetricRecorderHook&lt;br&gt;&lt;font style='font-size:10px'&gt;priority = 1000&lt;br&gt;写 Token / 模型 / 时间统计投影&lt;br&gt;捕获自身持久化异常 · 独立事务&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F1FF;strokeColor=#4F7CAC;fontColor=#17365D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="365" y="505" width="200" height="90" as="geometry" /></mxCell><mxCell id="11" value="CreditChargeHook&lt;br&gt;&lt;font style='font-size:9px'&gt;priority &amp;lt; 1000；先于 Metric&lt;br&gt;原子 pop snapshot&lt;br&gt;snapshot miss：按 source_msg_id 查既有 Charge，匹配则幂等&lt;br&gt;校验成功终态、非零 Usage、source_msg_id、actual_llm_code&lt;br&gt;捕获全部 Settlement 异常，失败不影响结果&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F8F1;strokeColor=#3A8D68;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="585" y="350" width="230" height="145" as="geometry" /></mxCell><mxCell id="12" value="Runtime DB 单事务&lt;br&gt;&lt;font style='font-size:9px'&gt;① ModelCallCharge UQ(source_msg_id)&lt;br&gt;→ 返回 canonical model_call_charge_id&lt;br&gt;② 费用 &amp;gt; 0：CreditTransaction&lt;br&gt;UQ(kind, source_ref = canonical ID)&lt;br&gt;③ 仅首次新 Transaction 原子增量 CreditBalance&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#F3E8FF;strokeColor=#8B5FBF;fontColor=#4C1D95;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="505" width="225" height="130" as="geometry" /></mxCell><mxCell id="13" value="5. MessageEndEvent&lt;br&gt;Transcript 持久化" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#C47A1B;fontColor=#7C3E00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="165" y="515" width="170" height="75" as="geometry" /></mxCell><mxCell id="14" value="不收费 / 永不补扣&lt;br&gt;&lt;font style='font-size:10px'&gt;error · aborted · timeout · retry/fallback 失败&lt;br&gt;Usage 缺失或全零 · source_msg_id 缺失&lt;br&gt;actual_llm_code 不可信 · snapshot 丢失且无既有 Charge&lt;br&gt;Settlement 失败&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBEB;strokeColor=#D6A84B;fontColor=#713F12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="400" width="330" height="100" as="geometry" /></mxCell><mxCell id="16" value="PreModelCall" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="17" value="Admission 通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="18" value="最终结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="19" value="读取配置 / 余额" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="5" target="8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="20" value="response / chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="6" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="21" value="下一 priority" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=1;entryY=0.25;" edge="1" parent="1" source="11" target="10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="575" y="455" /><mxPoint x="575" y="528" /></Array></mxGeometry></mxCell><mxCell id="22" value="先结算" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="7" target="11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="23" value="原子提交" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="24" value="Post hooks 完成" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.55;entryX=1;entryY=0.55;" edge="1" parent="1" source="10" target="13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="15" value="Admission 拒绝&lt;br&gt;&lt;font style='font-size:10px'&gt;blocking_error&lt;br&gt;Provider 不发请求&lt;br&gt;Run 进入 error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC6B6B;fontColor=#7F1D1D;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="245" width="130" height="105" as="geometry" /></mxCell><mxCell id="25" value="blocking_error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;dashed=1;dashPattern=6 4;strokeWidth=1.5;strokeColor=#DC6B6B;fontSize=10;fontColor=#7F1D1D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=1;entryY=0.35;" edge="1" parent="1" source="5" target="15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="168" /><mxPoint x="185" y="282" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="topup" name="充值与发放流程"><mxGraphModel dx="1000" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="650" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Mock 充值与 Credits 发放详细流程" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172033;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="650" height="35" as="geometry" /></mxCell><mxCell id="3" value="不使用 Outbox：CreditPayment.credit_fulfillment_status 表达跨库交付状态；Runtime CreditTransaction 以 credit_payment_id 保证幂等。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748B;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="53" width="790" height="22" as="geometry" /></mxCell><mxCell id="4" value="1. 已认证 Account&lt;br&gt;&lt;font style='font-size:10px'&gt;提交 option_code&lt;br&gt;+ idempotency_key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#C47A1B;fontColor=#7C3E00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="170" height="85" as="geometry" /></mxCell><mxCell id="5" value="2. Playground Backend 幂等查询&lt;br&gt;&lt;font style='font-size:9px'&gt;先查 UQ(account_user_code, idempotency_key)&lt;br&gt;既有 + 同 option_code：复用原始快照，不按当前配置重算&lt;br&gt;既有 + 不同 option_code：409&lt;br&gt;既有 credited：直接返回 200&lt;br&gt;不存在：才解析服务端 purchase option&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#C47A1B;fontColor=#7C3E00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="225" y="90" width="260" height="145" as="geometry" /></mxCell><mxCell id="6" value="3. Account DB 单事务（仅新订单）&lt;br&gt;&lt;font style='font-size:9px'&gt;创建不可变 CreditPurchaseOrder 快照&lt;br&gt;+ CreditPayment&lt;br&gt;credit_fulfillment_status = 'pending'&lt;br&gt;UQ(account_user_code, idempotency_key)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#C47A1B;fontColor=#7C3E00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="270" height="130" as="geometry" /></mxCell><mxCell id="7" value="4. 对新建或既有 pending Payment 尝试发放" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="525" y="275" width="260" height="55" as="geometry" /></mxCell><mxCell id="8" value="5. Runtime DB 单事务&lt;br&gt;&lt;font style='font-size:10px'&gt;正 CreditTransaction&lt;br&gt;kind = credit_purchase&lt;br&gt;source_ref = credit_payment_id&lt;br&gt;UQ(kind, source_ref)&lt;br&gt;仅首次新 Transaction 原子增量 CreditBalance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F8F1;strokeColor=#3A8D68;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="485" y="365" width="300" height="135" as="geometry" /></mxCell><mxCell id="9" value="6. Account DB 回写&lt;br&gt;credit_fulfillment_status = 'credited'&lt;br&gt;写 credited_at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#C47A1B;fontColor=#7C3E00;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="245" y="470" width="205" height="90" as="geometry" /></mxCell><mxCell id="10" value="完成&lt;br&gt;余额可用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E9F8F1;strokeColor=#3A8D68;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="140" height="65" as="geometry" /></mxCell><mxCell id="11" value="发放暂时失败&lt;br&gt;&lt;font style='font-size:10px'&gt;保留 credit_fulfillment_status = 'pending'&lt;br&gt;API 返回 202&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC6B6B;fontColor=#7F1D1D;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="595" y="535" width="205" height="75" as="geometry" /></mxCell><mxCell id="12" value="pending scanner&lt;br&gt;&lt;font style='font-size:10px'&gt;读取 Order 原始快照&lt;br&gt;重投相同 credit_payment_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="565" width="190" height="65" as="geometry" /></mxCell><mxCell id="13" value="关键崩溃窗口&lt;br&gt;&lt;font style='font-size:10px'&gt;Runtime 已入账，但 credited 回写失败：credit_fulfillment_status 仍为 'pending'；scanner 重投同一 credit_payment_id 时命中同一 CreditTransaction，返回幂等成功，再完成回写，不会重复增加 Credits。&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBEB;strokeColor=#D6A84B;fontColor=#713F12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="275" width="390" height="120" as="geometry" /></mxCell><mxCell id="14" value="购买请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="15" value="不存在：解析当前 option + 创建" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="16" value="Account DB commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="17" value="credit_payment_id + Order 快照" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="18" value="入账成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.65;entryX=1;entryY=0.35;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.55;entryX=1;entryY=0.5;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="20" value="暂时失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="8" target="11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="21" value="周期扫描" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#64748B;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.6;entryX=1;entryY=0.55;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="22" value="幂等重投" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;dashed=1;strokeWidth=1.5;strokeColor=#8B5CF6;fontSize=10;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.35;entryY=1;" edge="1" parent="1" source="12" target="8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="24" value="既有 pending：复用同一 credit_payment_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;dashed=1;dashPattern=6 4;strokeWidth=1.5;strokeColor=#8B5CF6;fontSize=9;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0;entryY=0.4;" edge="1" parent="1" source="5" target="7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="505" y="215" /><mxPoint x="505" y="297" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>